# 复制为 .env 后填写。填好的 .env 不要提交到仓库。

# X25519 私钥，PKCS8 PEM。一行里用 \n 表示换行。
PAYMENT_PRIVATE_KEY=

# 两个机器人在 BotFather 里各建一个，令牌不能相同
BOT_TOKEN=
MERCHANT_BOT_TOKEN=

# 商家的 Telegram 数字 ID，多个用英文逗号分开
ADMIN_TELEGRAM_IDS=

DATABASE_PATH=data/shop.db
HOST=127.0.0.1
PORT=8000

# 本店公网根地址，用来生成支付回调。例如 https://shop.example.com
PUBLIC_BASE_URL=
